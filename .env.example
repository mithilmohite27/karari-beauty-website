NEXT_PUBLIC_SITE_URL=https://www.kararibeauty.com

# Supabase public client values. These are safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side only. Never expose this in client components or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Customer Google sign-in uses Supabase Auth. Configure Google in Supabase Dashboard > Authentication > Providers > Google.
# Add this redirect URL in Supabase/Google settings:
# https://www.kararibeauty.com/auth/callback

# Google Analytics 4 measurement ID. Safe to expose to browser code.
# Optional: components/GoogleAnalytics.jsx falls back to the production ID when this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GJPVZ3WGN3

# Google Search Console ownership verification.
# In Search Console pick the "HTML tag" method and copy ONLY the content value -
# the token itself, not the whole <meta> element. Read at build time, so it
# applies on the next deployment after you set it. Leave empty to emit no tag.
GOOGLE_SITE_VERIFICATION=

# Cloudflare R2 image CDN.
#
# NEXT_PUBLIC_CDN_BASE is the switch for the whole pipeline. While it is empty
# the site serves images straight from Supabase Storage exactly as before.
# Setting it turns on the custom next/image loader, which serves pre-generated
# 400/800/1600px WebP variants from R2 and consumes no Vercel image
# transformations. Set it only after the bucket has a working custom domain.
NEXT_PUBLIC_CDN_BASE=

# R2 credentials. Server-side only. Needed by the admin upload route (to
# generate variants for new images) and by scripts/migrate-images-to-r2.mjs.
# Create the token under R2 > Manage API Tokens with Object Read & Write scoped
# to this one bucket - it does not need account-wide access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Razorpay test/live keys. Only NEXT_PUBLIC_RAZORPAY_KEY_ID is exposed to browser code.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
